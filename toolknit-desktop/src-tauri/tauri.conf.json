{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Karui 工具箱",
    "version": "../package.json",
    "identifier": "com.karui.toolbox",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [{
            "label": "main",
            "title": "Karui 工具箱",
            "width": 1100,
            "height": 800,
            "minWidth": 1100,
            "minHeight": 800,
            "maxWidth": 1100,
            "maxHeight": 800,
            "resizable": false,
            "fullscreen": false,
            "decorations": false,
            "shadow": false,
            "devtools": false,
            "dragDropEnabled": true
        }],
        "security": {
            "csp": "default-src 'self'; img-src 'self' asset: blob: data: https://pic1.imgdb.cn; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.deepseek.com https://api.openai.com https://dashscope.aliyuncs.com https://api.moonshot.cn; font-src 'self' data:",
            "assetProtocol": {
                "enable": true,
                "scope": ["$DOCUMENT/*", "$DOWNLOAD/*", "$APPDATA/*"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": ["app", "nsis"],
        "publisher": "dk-plus",
        "copyright": "Copyright © 2026 dk-plus",
        "shortDescription": "Karui 工具箱桌面应用",
        "longDescription": "由 Mr·Fan 打造的 dk-plus 本地多功能桌面工具箱。",
        "resources": ["resources/ffmpeg/ffmpeg.exe"],
        "icon": [
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installMode": "both",
                "installerIcon": "icons/icon.ico",
                "languages": ["English", "SimpChinese"],
                "displayLanguageSelector": true,
                "template": "./windows/installer.nsi",
                "installerHooks": "./windows/hooks.nsh"
            }
        }
    }
}